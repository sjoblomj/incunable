#!/bin/bash

awk -i inplace -i "utils.awk" -v additionalfiles="$3" '
BEGIN {
    # Read the numbers of all references. Each line has the form "name=number";
    # the number comes after the last equals sign.
    n = split(read_file(additionalfiles "/reflist"), lines, "\n")
    for (i = 1; i <= n; i++) {
        pos = match(lines[i], /=[^=]*$/)
        name = substr(lines[i], 1, pos - 1)
        if (pos > 0 && !(name in REF_NUMBERS))
            REF_NUMBERS[name] = substr(lines[i], pos + 1)
    }
}
{
    line = $0
    last_index = 0
    while (1) {
        remainder_of_line = substr(line, last_index + 1)
        pos_beg = index(remainder_of_line, "{{ref")
        if (pos_beg <= 0) {
            break
        }
        len = index(substr(remainder_of_line, pos_beg), "}}") + 1
        ref = update_ref(substr(remainder_of_line, pos_beg, len))

        line = substr(line, 0, last_index + pos_beg - 1) ref substr(remainder_of_line, pos_beg + len)
        last_index += pos_beg + length(ref)
    }
    print line
}

function update_ref(template,  ref, number) {
    ref = get_parameter(template, "ref")
    number = find_ref_number(ref)

    sub("{{ref ", "{{ref |num=" number " ", template)
    return template
}

function find_ref_number(ref) {
    return (ref in REF_NUMBERS) ? REF_NUMBERS[ref] : -1
}
' "$1"
